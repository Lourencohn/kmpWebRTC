CREATE TABLE IF NOT EXISTS SessionEntity (
    sessionId TEXT NOT NULL PRIMARY KEY,
    token TEXT NOT NULL UNIQUE,
    url TEXT NOT NULL,
    sellerName TEXT NOT NULL,
    empresaSlug TEXT NOT NULL,
    catalogoUuid TEXT NOT NULL,
    catalogoNome TEXT,
    clientName TEXT,
    clientShop TEXT,
    scheduledFor TEXT,
    createdAtMs INTEGER NOT NULL,
    expiresAtMs INTEGER NOT NULL,
    clientEmail TEXT,
    catalogoLinkId INTEGER,
    clientPhone TEXT
);

insertSession:
INSERT INTO SessionEntity(sessionId, token, url, sellerName, empresaSlug, catalogoUuid, catalogoNome, clientName, clientShop, scheduledFor, createdAtMs, expiresAtMs, clientEmail, catalogoLinkId, clientPhone)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllSessions:
SELECT * FROM SessionEntity
ORDER BY createdAtMs DESC;

selectSessionById:
SELECT * FROM SessionEntity WHERE sessionId = ?;
