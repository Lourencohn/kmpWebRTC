CREATE TABLE IF NOT EXISTS PriceTableEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    idErp TEXT,
    descricao TEXT,
    situacao TEXT,
    percDesconto REAL,
    percParceria REAL,
    percGerencial REAL,
    updatedAt TEXT,
    updatedAtMs INTEGER
);

CREATE INDEX IF NOT EXISTS idx_pricetable_iderp ON PriceTableEntity(idErp);

CREATE TABLE IF NOT EXISTS ProductPriceEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    tabelaPrecoId INTEGER,
    tabelaPrecoIdErp TEXT,
    produtoPreId INTEGER,
    produtoIdErp TEXT,
    precoCents INTEGER,
    prazoMedio TEXT,
    agrupamento TEXT,
    listaGradeJson TEXT,
    updatedAt TEXT,
    updatedAtMs INTEGER
);

CREATE INDEX IF NOT EXISTS idx_prodprice_lookup ON ProductPriceEntity(produtoPreId, tabelaPrecoId);
CREATE INDEX IF NOT EXISTS idx_prodprice_iderp ON ProductPriceEntity(produtoIdErp);

CREATE TABLE IF NOT EXISTS PrazoEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    idErp TEXT,
    descricao TEXT,
    parcelas INTEGER,
    tipo TEXT,
    prazoMedio REAL,
    diasParcelasCsv TEXT,
    situacao TEXT,
    percDesconto REAL,
    updatedAt TEXT,
    updatedAtMs INTEGER
);

CREATE TABLE IF NOT EXISTS SaleTypeEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    idErp TEXT,
    descricao TEXT,
    geraComissao INTEGER NOT NULL DEFAULT 0,
    geraContasReceber INTEGER NOT NULL DEFAULT 0,
    parcelaMinima INTEGER,
    baixaEstoque INTEGER NOT NULL DEFAULT 0,
    origemPedido TEXT,
    updatedAt TEXT,
    updatedAtMs INTEGER
);

upsertPriceTable:
INSERT OR REPLACE INTO PriceTableEntity(id, idErp, descricao, situacao, percDesconto, percParceria, percGerencial, updatedAt, updatedAtMs)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllPriceTables:
SELECT * FROM PriceTableEntity ORDER BY descricao ASC;

deletePriceTablesByIds:
DELETE FROM PriceTableEntity WHERE id IN ?;

upsertProductPrice:
INSERT OR REPLACE INTO ProductPriceEntity(id, tabelaPrecoId, tabelaPrecoIdErp, produtoPreId, produtoIdErp, precoCents, prazoMedio, agrupamento, listaGradeJson, updatedAt, updatedAtMs)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectPriceForProduct:
SELECT * FROM ProductPriceEntity WHERE produtoPreId = ? AND tabelaPrecoId = ?;

selectPricesForTable:
SELECT * FROM ProductPriceEntity WHERE tabelaPrecoId = ?;

deleteProductPricesByIds:
DELETE FROM ProductPriceEntity WHERE id IN ?;

upsertPrazo:
INSERT OR REPLACE INTO PrazoEntity(id, idErp, descricao, parcelas, tipo, prazoMedio, diasParcelasCsv, situacao, percDesconto, updatedAt, updatedAtMs)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllPrazos:
SELECT * FROM PrazoEntity ORDER BY prazoMedio ASC;

deletePrazosByIds:
DELETE FROM PrazoEntity WHERE id IN ?;

upsertSaleType:
INSERT OR REPLACE INTO SaleTypeEntity(id, idErp, descricao, geraComissao, geraContasReceber, parcelaMinima, baixaEstoque, origemPedido, updatedAt, updatedAtMs)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllSaleTypes:
SELECT * FROM SaleTypeEntity ORDER BY descricao ASC;

deleteSaleTypesByIds:
DELETE FROM SaleTypeEntity WHERE id IN ?;
