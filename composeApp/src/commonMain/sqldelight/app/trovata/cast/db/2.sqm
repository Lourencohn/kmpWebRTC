CREATE TABLE IF NOT EXISTS PresentationEntity (
    presentationId TEXT NOT NULL PRIMARY KEY,
    shareUrl TEXT NOT NULL,
    empresaSlug TEXT NOT NULL,
    catalogoUuid TEXT NOT NULL,
    catalogoNome TEXT NOT NULL,
    sellerId TEXT NOT NULL,
    sellerName TEXT NOT NULL,
    recordedAtMs INTEGER NOT NULL,
    durationMs INTEGER NOT NULL,
    eventCount INTEGER NOT NULL,
    uploadedAtMs INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_presentation_empresa ON PresentationEntity(empresaSlug, recordedAtMs);
