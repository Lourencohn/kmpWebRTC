CREATE TABLE IF NOT EXISTS Complemento1Entity (
    id INTEGER NOT NULL PRIMARY KEY,
    idErp TEXT,
    descricao TEXT,
    tipoComplementoIdErp TEXT,
    updatedAt TEXT,
    updatedAtMs INTEGER
);
CREATE INDEX IF NOT EXISTS idx_compl1_iderp ON Complemento1Entity(idErp);

CREATE TABLE IF NOT EXISTS Complemento2Entity (
    id INTEGER NOT NULL PRIMARY KEY,
    idErp TEXT,
    descricao TEXT,
    tipoComplementoIdErp TEXT,
    updatedAt TEXT,
    updatedAtMs INTEGER
);
CREATE INDEX IF NOT EXISTS idx_compl2_iderp ON Complemento2Entity(idErp);

