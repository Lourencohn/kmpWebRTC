    id INTEGER NOT NULL PRIMARY KEY,
    idErp TEXT,
    sequencia INTEGER,
    complemento2Id INTEGER,
    updatedAt TEXT,
    updatedAtMs INTEGER
);

upsertCategoria:
INSERT OR REPLACE INTO CategoriaEntity(id, idErp, descricao, situacao, updatedAt, updatedAtMs) VALUES (?, ?, ?, ?, ?, ?);
selectAllCategorias:
SELECT * FROM CategoriaEntity ORDER BY descricao ASC;
deleteCategoriasByIds:
DELETE FROM CategoriaEntity WHERE id IN ?;

upsertColecao:
INSERT OR REPLACE INTO ColecaoEntity(id, idErp, descricao, situacao, updatedAt, updatedAtMs) VALUES (?, ?, ?, ?, ?, ?);
