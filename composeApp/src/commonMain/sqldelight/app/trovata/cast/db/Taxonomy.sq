CREATE TABLE IF NOT EXISTS CategoriaEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    idErp TEXT,
    descricao TEXT,
    situacao TEXT,
    updatedAt TEXT,
    updatedAtMs INTEGER
);
CREATE INDEX IF NOT EXISTS idx_categoria_iderp ON CategoriaEntity(idErp);

CREATE TABLE IF NOT EXISTS ColecaoEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    idErp TEXT,
    descricao TEXT,
    situacao TEXT,
    updatedAt TEXT,
    updatedAtMs INTEGER
);
CREATE INDEX IF NOT EXISTS idx_colecao_iderp ON ColecaoEntity(idErp);

CREATE TABLE IF NOT EXISTS MarcaEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    idErp TEXT,
    descricao TEXT,
    situacao TEXT,
    updatedAt TEXT,
    updatedAtMs INTEGER
);
CREATE INDEX IF NOT EXISTS idx_marca_iderp ON MarcaEntity(idErp);

CREATE TABLE IF NOT EXISTS GrupoProdutoEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    idErp TEXT,
    descricao TEXT,
    situacao TEXT,
    updatedAt TEXT,
    updatedAtMs INTEGER
);

CREATE TABLE IF NOT EXISTS GeneroEntity (
    id INTEGER NOT NULL PRIMARY KEY,
