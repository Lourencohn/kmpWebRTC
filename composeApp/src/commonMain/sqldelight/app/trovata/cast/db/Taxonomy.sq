    id INTEGER NOT NULL PRIMARY KEY,
    idErp TEXT,
    descricao TEXT,
    situacao TEXT,
    updatedAt TEXT,
    updatedAtMs INTEGER
);

CREATE TABLE IF NOT EXISTS EspecieEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    idErp TEXT,
    descricao TEXT,
    situacao TEXT,
    updatedAt TEXT,
    updatedAtMs INTEGER
